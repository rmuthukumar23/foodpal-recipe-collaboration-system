<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<TitledPane animated="false" prefHeight="500.0" prefWidth="700.0" text="Edit Recipe" style="-fx-text-fill: #3B4CCA;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.EditRecipeCtrl">
  <content><TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" style="-fx-border-color: #3B4CCA;"><tabs>
    <Tab fx:id="nameTab" text="Name"><content><BorderPane><top><Label text="Recipe Name" BorderPane.alignment="CENTER" style="-fx-text-fill: #3B4CCA;"><font><Font size="23.0"/></font></Label></top><center><TextArea fx:id="ingredientsTextArea1" promptText="Enter recipe name..."/></center><bottom><ButtonBar><buttons><Button onAction="#onNext" text="Next"/></buttons></ButtonBar></bottom></BorderPane></content></Tab>
    <Tab fx:id="ingredientsTab" text="Ingredients"><content><BorderPane><top><Label text="Recipe Ingredients" BorderPane.alignment="CENTER" style="-fx-text-fill: #3B4CCA;"><font><Font size="23.0"/></font></Label></top><center><VBox spacing="8"><HBox spacing="8"><ComboBox fx:id="globalIngredientComboBox" editable="true" promptText="Ingredient..."/><TextField fx:id="ingredientValueField" promptText="Value..."/><ComboBox fx:id="unitComboBox" promptText="Unit..."/><Button onAction="#onAddIngredient" text="Add"/><Button fx:id="updateIngredientButton" disable="true" onAction="#onUpdateIngredient" text="Update"/><Button fx:id="clearIngredientButton" disable="true" onAction="#onClearIngredientEditor" text="Clear"/></HBox><HBox spacing="8"><CheckBox fx:id="informalAmountCheckBox" text="Informal Amount"/><TextField fx:id="informalAmountField" disable="true" promptText="e.g. a pinch / 1 can..."/></HBox><ListView fx:id="ingredientsListView" VBox.vgrow="ALWAYS"/><Button fx:id="deleteIngredientButton" disable="true" onAction="#onDeleteSelectedIngredient" text="Delete Selected"/></VBox></center><bottom><ButtonBar><buttons><Button onAction="#onNext" text="Next"/></buttons></ButtonBar></bottom></BorderPane></content></Tab>
    <Tab fx:id="preparationTab" text="Preparation"><content><BorderPane><top><Label text="Recipe Procedure" BorderPane.alignment="CENTER" style="-fx-text-fill: #3B4CCA;"><font><Font size="23.0"/></font></Label></top><center><TextArea fx:id="preparationTextArea" promptText="Enter preparation steps (one per line)..."/></center><bottom><ButtonBar><buttons><Button onAction="#onNext" text="Next"/></buttons></ButtonBar></bottom></BorderPane></content></Tab>
    <Tab fx:id="additionalTab" text="Categories"><content><BorderPane><top><Label text="Categories and Labels" BorderPane.alignment="CENTER" style="-fx-text-fill: #3B4CCA;"><font><Font size="23.0"/></font></Label></top><center><ScrollPane fitToWidth="true"><content><VBox fx:id="labelsContainer" spacing="15"><padding><Insets top="15" right="15" bottom="15" left="15"/></padding><VBox spacing="5"><Label text="Language (Required) *"/><ComboBox fx:id="languageComboBox" promptText="Select language..."/></VBox><VBox spacing="5"><Label text="Cooking Time (Optional)"/><ComboBox fx:id="cookingTimeComboBox" promptText="Select cooking time..."/></VBox><VBox spacing="5"><Label text="Cuisine (Optional)"/><ComboBox fx:id="cuisineComboBox" promptText="Select cuisine..."/></VBox><VBox spacing="5"><Label text="Dietary Restrictions"/><VBox fx:id="dietaryCheckBoxContainer" spacing="5"/></VBox><VBox spacing="5"><Label text="Protein Type"/><VBox fx:id="proteinCheckBoxContainer" spacing="5"/></VBox><VBox spacing="5"><Label text="Meal Type"/><VBox fx:id="mealTypeCheckBoxContainer" spacing="5"/></VBox></VBox></content></ScrollPane></center><bottom><ButtonBar><buttons><Button onAction="#onNext" text="Done"/></buttons></ButtonBar></bottom></BorderPane></content></Tab>
  </tabs></TabPane></content>
</TitledPane>