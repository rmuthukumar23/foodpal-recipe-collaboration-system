<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane prefHeight="400.0" prefWidth="500.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.TimerCtrl">
  <top><BorderPane prefHeight="50.0" style="-fx-background-color: #3B4CCA;"><center><Label text="Cooking Timer ⏲" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"><font><Font size="22.0"/></font></Label></center><left><Button fx:id="closeButton" onAction="#onClose" text="Close"><BorderPane.margin><Insets left="10"/></BorderPane.margin></Button></left></BorderPane></top>
  <center><VBox alignment="CENTER" spacing="20"><padding><Insets bottom="20" left="20" right="20" top="20"/></padding><HBox alignment="CENTER" spacing="10"><VBox alignment="CENTER" spacing="5"><Label text="Hours"/><Spinner fx:id="hoursSpinner" prefWidth="80" editable="true"/></VBox><Label text=":"/><VBox alignment="CENTER" spacing="5"><Label text="Minutes"/><Spinner fx:id="minutesSpinner" prefWidth="80" editable="true"/></VBox><Label text=":"/><VBox alignment="CENTER" spacing="5"><Label text="Seconds"/><Spinner fx:id="secondsSpinner" prefWidth="80" editable="true"/></VBox></HBox><Label fx:id="timerDisplay" text="00:00:00" style="-fx-text-fill: #3B4CCA;"><font><Font name="Arial" size="48"/></font></Label><HBox alignment="CENTER" spacing="15"><Button fx:id="startButton" onAction="#onStart" text="Start"/><Button fx:id="pauseButton" onAction="#onPause" text="Pause"/><Button fx:id="resetButton" onAction="#onReset" text="Reset"/></HBox></VBox></center>
</BorderPane>