<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<BorderPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.ConfirmRecipeDeletionCtrl">
    <center><VBox prefHeight="157.0" prefWidth="300.0" BorderPane.alignment="CENTER"><children>
        <Label alignment="CENTER" prefWidth="601.0" text="Are you sure you want to delete:" textAlignment="CENTER" style="-fx-text-fill: #3B4CCA;"><font><Font size="35.0" /></font></Label>
        <Pane prefHeight="39.0" prefWidth="600.0" />
        <Label fx:id="recipeNameLabel" alignment="CENTER" prefWidth="601.0" text="Recipe" textAlignment="CENTER" style="-fx-text-fill: #3B4CCA;"><font><Font size="35.0" /></font></Label>
        <HBox alignment="CENTER" prefHeight="100.0" spacing="50.0"><children>
            <Button mnemonicParsing="false" onAction="#onNo" text="No" style="-fx-background-color: #FFFFFF; -fx-border-color: #3B4CCA; -fx-text-fill: #3B4CCA;"><font><Font size="22.0" /></font></Button>
            <Button mnemonicParsing="false" onAction="#onYes" text="Yes" style="-fx-background-color: #3B4CCA; -fx-text-fill: #FFFFFF;"><font><Font size="22.0" /></font></Button>
        </children></HBox>
    </children></VBox></center>
</BorderPane>