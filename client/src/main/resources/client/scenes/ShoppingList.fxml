<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<BorderPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.scenes.ShoppingListCtrl">
    <top><BorderPane prefHeight="55.0" style="-fx-background-color: #3B4CCA;"><padding><Insets bottom="8" left="12" right="12" top="8"/></padding><left><Button fx:id="backButton" onAction="#onBack" text="← Back"/></left><center><Label style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;" text="🛒 Shopping List"><font><Font size="22"/></font></Label></center><right><HBox spacing="10"><Button fx:id="printButton" onAction="#onPrint" text="🖨"/><Button fx:id="resetButton" onAction="#onReset" text="Clear All"/></HBox></right></BorderPane></top>
    <center><VBox spacing="14"><padding><Insets bottom="14" left="14" right="14" top="14"/></padding><Label style="-fx-font-weight: bold;" text="Add Ingredients from Recipe"/><HBox spacing="10"><Label text="Select recipe:"/><ComboBox fx:id="recipeComboBox" prefWidth="250"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="addFromRecipeButton" onAction="#onAddFromRecipe" text="Add All Ingredients"/></HBox><Separator/><Label style="-fx-font-weight: bold;" text="Shopping List Items"/><ListView fx:id="shoppingListView" VBox.vgrow="ALWAYS"/><HBox spacing="10"><Button fx:id="removeSelectedButton" onAction="#onRemoveSelected" text="Remove Selected"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="hintLabel" text="Items can include amounts and recipe source"/></HBox><Separator/><Label style="-fx-font-weight: bold;" text="Add Custom Item"/><HBox spacing="10"><Label text="Item:"/><TextField fx:id="newItemField" promptText="e.g., Tomatoes" HBox.hgrow="ALWAYS"/><Label text="Amount:"/><TextField fx:id="newAmountField" promptText="e.g., 2 kg" prefWidth="100"/><Button fx:id="editItemButton" onAction="#onEditItem" text="Update Item"/><Button fx:id="addItemButton" onAction="#onAddManualItem" text="Add Item"/></HBox></VBox></center>
</BorderPane>